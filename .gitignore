# Secrets - 절대 커밋 금지 (디스코드 봇 토큰, 파파고/Azure API 키 등)
# .env.example도 레포에는 안 올리고 로컬에서만 따로 관리
.env
.env.*
*.env

# 인증서/키/자격증명 파일
*.pem
*.key
*.p12
*.jks
*.keystore
*credentials*.json
secrets.*

# 로컬 전용 설정 (개인 자격증명이 섞일 수 있음)
local.properties
gradle.properties

# 로컬 전용 작업 메모 (레포에는 안 올림)
CLAUDE.md

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# VS Code Java 확장 빌드 산출물
bin/

# IntelliJ IDEA
.idea/
*.iml
out/

# macOS
.DS_Store

# 로그 파일
logs/
*.log
